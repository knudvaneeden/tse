string proc GetShortFilename(string long_fn)
	string short_fn[MAXPATH] = Format("":MAXPATH)

	return (iif(GetShortPathName(long_fn, short_fn, sizeof(short_fn)) > 0,
			SubStr(short_fn, 1, Pos(Chr(0), short_fn)-1), long_fn))
end
