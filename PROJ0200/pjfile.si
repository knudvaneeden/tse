	integer i

	//$ todo: need a better check
	if CurrExt() == c_stExt
		// open the project
		if OpenProject(fn)
			// abandon the .pj file
			//$ review: move this before OpenProject?
			//$ review: if move before OpenProject, fix wrt g_fGotoNextFile...
			AbandonFile(cid)

			// remove from history list
			//for i = NumHistoryItems(_EDIT_HISTORY_) downto 1
			for i = 1 downto 1
				st = Lower(GetHistoryStr(_EDIT_HISTORY_, i))
				if Lower(QuotePath(fn)) == st
					DelHistoryStr(_EDIT_HISTORY_, i)
				elseif Lower(QuotePath(fn)) == st[1:Length(QuotePath(fn))]
					st = Trim(st[Length(QuotePath(fn))+1:255])
					//$ review: not sure how to do this when looping since i
					// can't specify the index i want to insert it at.
					AddHistoryStr(st, _EDIT_HISTORY_)
				endif
			endfor
		endif
	endif
end
#endif



///////////////////////////////////////////////////////////////////////////
// Main

// Append registered saved projects without activating or restoring them.
proc PROJ_CollectScopeProjects()
    integer originalBuffer = GetBufferId()
    integer outputBuffer = GetGlobalInt("PROJ_ScopeRequestBuffer")
    integer namesBuffer = 0
    string entry[255]
    string activeProject[255] = ""
    if Get_Int(iProjectId)
        GotoBufferId(Get_Int(iProjectId))
        activeProject = CurrFilename()
        GotoBufferId(originalBuffer)
    endif
    PushBlock()
    if outputBuffer and OpenDatabase()
        GotoBufferId(Get_Int(iDatabaseId))
        if MarkProjectSection(c_stAllProjects)
            namesBuffer = CreateTempBuffer()
            if namesBuffer
                CopyBlock()
                UnMarkBlock()
                BegFile()
                do NumLines() times
                    entry = Trim(GetText(1, 255))
                    if Length(entry) and PROJ_IsSavedProject(entry) and
                       Lower(GetProjectFullPathname(entry)) <> Lower(activeProject)
                        AddLine("P" + GetProjectFullPathname(entry), outputBuffer)
                    endif
                    GotoBufferId(namesBuffer)
                    Down()
                enddo
                AbandonFile(namesBuffer)
            endif
        endif
    endif
    PopBlock()
    GotoBufferId(originalBuffer)
end

proc Main()
#ifdef DEBUG
	EnsureMainLoaded()
#endif

	case Query(MacroCmdLine)
		when "-OpenProject"
			Set(MacroCmdLine, Str(OpenProject(GetGlobalStr(c_stXTALK))))
		when "-SaveProject:0"
			Set(MacroCmdLine, Str(SaveProject(FALSE)))
		when "-SaveProject:1"
			Set(MacroCmdLine, Str(SaveProject(TRUE)))
		when "-CloseProject:0"
			CloseProject(FALSE)
		when "-CloseProject:1"
			CloseProject(TRUE)
		when "-CloseAllProjects"
			CloseAllProjects()
		when "-lCloseProject"
			lCloseProject()

		when "-NewProject"
			NewProject()
		when "-TransferProjects"
			PROJ_TransferProjects(Val(GetGlobalStr(c_stXTALK)))
		when "-CollectScopeProjects"
            PROJ_CollectScopeProjects()
		when "-ViewAllProjects"
			ViewAllProjects()
		when "-DeleteProject"
			DeleteProject()
		when "-RenameProject"
            RenameProject()
		when "-CopyProject"
			CopyProject()
		when "-DoOptionsMenu"
			DoOptionsMenu()
#if 0
		when "-AddFilesToProject"
			AddFilesToProject()
#endif
		when "-EditProjDir:0"
			EditProjDir(FALSE)
		when "-EditProjDir:1"
			EditProjDir(TRUE)
		when "-DoProjectSettings"
			DoProjectSettings()

		when "-OpenDatabase"
			Set(MacroCmdLine, Str(OpenDatabase()))
		when "-GetDatabaseOptions"
			GetDatabaseOptions()
		when "-SetDatabaseOptions"
			SetDatabaseOptions()
		when "-SaveDatabase"
			SaveDatabase()

		when "-TimeOutMessage"
			TimeOutMessage(Val(GetToken(GetGlobalStr(c_stXTALK), ":", 1)),
						   GetToken(GetGlobalStr(c_stXTALK), ":", 2))

		otherwise
			Warn("Do not execute PJFILE directly.  Execute PROJ instead.")
#ifdef DEBUG
			Warn(Query(MacroCmdLine))
#endif
	endcase
end

