string proc PROJ_ConfiguredProjectFilename()
    string configuredName[255] = RemoveQuotes(PROJ_PackageSetting("projectdirectoryorfilename"))
    if Length(configuredName)
        if not Length(SplitPath(configuredName, _DRIVE_|_PATH_))
            configuredName = GetFullProjDir() + configuredName
        elseif not Length(SplitPath(configuredName, _DRIVE_)) and
                SubStr(configuredName, 1, 1) <> "\" and SubStr(configuredName, 1, 1) <> "/"
            configuredName = GetInstallationDir() + configuredName
        endif
        if Lower(SplitPath(configuredName, _EXT_)) <> c_stExt
            configuredName = configuredName + c_stExt
        endif
    endif
    return(configuredName)
end

integer proc PROJ_AskNewProjectFilename(string prompt, var string filename)
    filename = PROJ_ConfiguredProjectFilename()
    if Length(filename)
        return(TRUE)
    endif
    return(AskFilename(prompt, filename))
end




